# Pilih satu penyedia (semua kompatibel OpenAI). Nilai contoh ini harus diganti dengan API key asli.
LLM_API_KEY=your_groq_api_key_here
# Groq (default):  https://api.groq.com/openai/v1  | model openai/gpt-oss-120b

# Ambang kemiripan kata jawaban vs chunk sumber (0-1). Turunkan jika terlalu banyak soal ditolak.
QUTO_GROUNDING_THRESHOLD=0.6
QUTO_MAX_RETRIES=2

# Secret administrator untuk menerbitkan undangan registrasi dosen.
# Buat nilai acak yang panjang; jangan gunakan contoh ini sebagai secret produksi.
QUTO_ADMIN_API_KEY=

# Aktifkan hanya untuk registrasi demo dosen dari localhost (tidak untuk produksi).
QUTO_ENABLE_DEMO_LECTURER_REGISTRATION=false

# Reset password menggunakan SMTP STARTTLS (port 587) atau implicit TLS (port 465).
# Untuk layanan tanpa autentikasi, biarkan username dan password kosong.
QUTO_SMTP_HOST=
QUTO_SMTP_PORT=587
QUTO_SMTP_USERNAME=
QUTO_SMTP_PASSWORD=
QUTO_SMTP_FROM=
